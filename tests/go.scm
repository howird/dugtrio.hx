;; Run from the repository root with: steel tests/go.scm
(require "../go.scm")

(define (check name expected actual)
  (unless (equal? expected actual)
    (error! (list name 'expected expected 'actual actual))))

;; These payloads have no relationship to directories or filesystem paths.
(define active (GoGroup 'active #f '(first second third fourth fifth sixth seventh eighth ninth tenth eleventh twelfth)))
(define left (GoGroup 'left 'near (range 0 26)))
(define far (GoGroup 'left 'far '()))
(define right (GoGroup 'right 'right (range 0 26)))

(define (select labels prefix key)
  (define result (go-resolve labels prefix key))
  (if (GoPending? result)
      (list 'pending (GoPending-prefix result))
      (and result (GoMatched-target result))))

(define labels (go-labels (list far left active right) #f))
(check 'active-first 'first (select labels "" "a"))
(check 'skip-h 'eighth (select labels "" "i"))
(check 'skip-j-k-l 'ninth (select labels "" "m"))
(check 'older-prefix-after-active 'far (select labels "q" "q"))
(check 'older-prefix-enters '(pending "q") (select labels "" "q"))
(check 'left-prefix '(pending "h") (select labels "" "h"))
(check 'left-focus 'near (select labels "h" "h"))
(check 'left-skip-own-suffix 7 (select labels "h" "i"))
(check 'left-keeps-j-suffix 8 (select labels "h" "j"))
(check 'left-keeps-other-reserved-suffix 10 (select labels "h" "l"))
(check 'right-prefix '(pending "l") (select labels "" "l"))
(check 'right-focus 'right (select labels "l" "l"))
(check 'right-keeps-k-suffix 10 (select labels "l" "k"))
(check 'right-skip-own-suffix 11 (select labels "l" "m"))
(check 'invalid-suffix #f (select labels "l" "?"))
(check 'non-character #f (select labels "" #f))
(check 'multi-character #f (select labels "" "ll"))
(check 'no-rendered-labels #f (select #f "" "a"))

(define direct (go-labels (list far left active right) 'second))
(check 'direct-file 'second (select direct "" "l"))
(check 'compact-active 'third (select direct "" "b"))
(check 'compact-prefixes 'far (select direct "p" "p"))
(check 'no-right-focus-with-direct #f (select direct "l" "l"))
(check 'no-right-row-with-direct #f (select direct "l" "a"))

(define neighbors (go-labels (list far left active right) 'second #:next 'third #:previous 'first))
(check 'next 'third (select neighbors "" "j"))
(check 'previous 'first (select neighbors "" "k"))
(check 'direct-with-neighbors 'second (select neighbors "" "l"))
(check 'compact-after-neighbors 'fourth (select neighbors "" "a"))
(check 'prefix-after-neighbors 'far (select neighbors "n" "n"))
(check 'no-duplicate-neighbor-labels 39 (length (hash-keys->list neighbors)))

(define active-only (go-labels (list active) #f))
(check 'unavailable-left #f (select active-only "" "h"))
(check 'unavailable-right #f (select active-only "" "l"))
;; Older panes skip reserved prefixes, even if the corresponding standalone
;; shortcut or fixed-prefix pane is unavailable.
(for-each (lambda (case)
            (define bindings (go-labels (list far left (GoGroup 'active #f (range 0 (car case)))) #f))
            (check 'reserved-dynamic-prefix 'far (select bindings (cadr case) (cadr case)))
            (check 'unavailable-next #f (select bindings "" "j"))
            (check 'unavailable-previous #f (select bindings "" "k")))
          '((7 "i") (8 "m")))

(define full (GoGroup 'active #f (range 0 26)))
(define saturated (go-labels (list far left full right) #f))
(check 'active-limit 21 (select saturated "" "z"))
(check 'no-spare-older-prefix 74 (length (hash-keys->list saturated)))
(check 'fixed-left-at-capacity 'near (select saturated "h" "h"))
(check 'fixed-right-at-capacity 'right (select saturated "l" "l"))
(check 'direct-beyond-active-limit 25 (select (go-labels (list full) 25) "" "l"))
(check 'direct-must-be-visible '(pending "l") (select (go-labels (list right) 'absent) "" "l"))
(define partial (go-labels (list full) #f #:next 'absent #:previous 25))
(check 'next-must-be-visible #f (select partial "" "j"))
(check 'previous-beyond-active-limit 25 (select partial "" "k"))

(displayln "Go tests passed")
